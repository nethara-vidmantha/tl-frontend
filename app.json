{
  "expo": {
    "name": "TaskLanka",
    "slug": "tasklanka",
    "scheme": "tasklanka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D5C75"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tasklanka.app"
    },
    "android": {
      "package": "com.tasklanka.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D5C75"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TaskLanka to access your photos for profile pictures.",
          "cameraPermission": "Allow TaskLanka to access your camera for taking profile pictures."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "212ab1c2-9bc7-4618-a43f-09b4df4c038e"
      }
    }
  }
}
